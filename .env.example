# AppTrove SDK Configuration
# Copy this file to .env and fill in your actual values

# Android AppTrove SDK Keys
ANDROID_APPTROVE_SDK_KEY=your_android_sdk_key_here
ANDROID_APPTROVE_SECRET_ID=your_android_secret_id_here
ANDROID_APPTROVE_SECRET_KEY=your_android_secret_key_here

# iOS AppTrove SDK Keys
IOS_APPTROVE_SDK_KEY=your_ios_sdk_key_here
IOS_APPTROVE_SECRET_ID=your_ios_secret_id_here
IOS_APPTROVE_SECRET_KEY=your_ios_secret_key_here

# Note: Never commit the actual .env file to git
# The .env file is already added to .gitignore
